# Keep LF line endings across platforms so differential tests and PEM fixtures
# stay byte-identical on Linux, macOS, and Windows.

* text=auto

# Source and config files use LF in the tree and on checkout.
*.py      text eol=lf
*.brat    text eol=lf
*.bri     text eol=lf
*.md      text eol=lf
*.json    text eol=lf
*.toml    text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.sh      text eol=lf
*.bash    text eol=lf
*.h       text eol=lf
*.c       text eol=lf diff=cpp
*.cpp     text eol=lf diff=cpp
*.txt     text eol=lf

# Certificates and keys require LF line endings.
*.pem     text eol=lf
*.key     text eol=lf
*.crt     text eol=lf

# Binary artifacts are never line-converted.
*.exe     binary
*.so      binary
*.dylib   binary
*.dll     binary
*.o       binary
*.obj     binary
*.a       binary
*.lib     binary
*.zip     binary
*.png     binary
*.jpg     binary
*.ico     binary
*.pdf     binary
