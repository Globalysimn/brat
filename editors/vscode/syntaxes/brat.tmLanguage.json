{
  "name": "BRAT",
  "scopeName": "source.brat",
  "fileTypes": [
    "brat",
    "bri"
  ],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#declarations" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#literals" },
    { "include": "#calls" },
    { "include": "#identifiers" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.documentation.brat",
          "match": "///.*$",
          "captures": {
            "0": {
              "patterns": [
                {
                  "name": "keyword.other.documentation.contract.brat",
                  "match": "@contract\\b"
                }
              ]
            }
          }
        },
        {
          "name": "comment.line.double-slash.brat",
          "match": "//.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.raw.brat",
          "begin": "\\br\"",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.string.begin.brat" }
          },
          "end": "\"",
          "endCaptures": {
            "0": { "name": "punctuation.definition.string.end.brat" }
          }
        },
        {
          "name": "string.quoted.double.brat",
          "begin": "\"",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.string.begin.brat" }
          },
          "end": "\"",
          "endCaptures": {
            "0": { "name": "punctuation.definition.string.end.brat" }
          },
          "patterns": [
            {
              "name": "constant.character.escape.brat",
              "match": "\\\\(?:x[0-9A-Fa-f]{2}|u\\{[0-9A-Fa-f]{1,6}\\}|.)"
            },
            {
              "name": "meta.interpolation.brat",
              "begin": "\\{",
              "beginCaptures": {
                "0": { "name": "punctuation.section.interpolation.begin.brat" }
              },
              "end": "\\}",
              "endCaptures": {
                "0": { "name": "punctuation.section.interpolation.end.brat" }
              },
              "patterns": [
                { "include": "$self" }
              ]
            }
          ]
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(fn)\\s+([A-Za-z_][A-Za-z0-9_]*)\\b",
          "captures": {
            "1": { "name": "storage.modifier.brat" },
            "2": { "name": "entity.name.function.definition.brat" }
          }
        },
        {
          "match": "\\b(struct|union|enum|trait|impl)\\s+([A-Z][A-Za-z0-9_]*)\\b",
          "captures": {
            "1": { "name": "storage.modifier.brat" },
            "2": { "name": "entity.name.type.declaration.brat" }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.brat",
          "match": "\\b(if|else|while|for|in|match|return|break|continue|try|catch|defer|spawn|scope|par|arena|unsafe)\\b"
        },
        {
          "name": "storage.modifier.brat",
          "match": "\\b(pub|use|import|fn|export|extern|packed|struct|union|enum|trait|impl|let|mut|move|const)\\b"
        },
        {
          "name": "variable.language.self.brat",
          "match": "\\bself\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.brat",
          "match": "\\b(i8|u8|i16|u16|i32|u32|i64|u64|isize|usize|f32|f64|bool|str|ptr|slice|vec|map|chan|dyn)\\b"
        },
        {
          "name": "support.constant.variant.brat",
          "match": "\\b(Some|Ok|Err)\\b"
        }
      ]
    },
    "literals": {
      "patterns": [
        {
          "name": "constant.language.brat",
          "match": "\\b(true|false|none)\\b"
        },
        {
          "name": "constant.numeric.hex.brat",
          "match": "\\b0[xX][0-9A-Fa-f][0-9A-Fa-f_]*\\b"
        },
        {
          "name": "constant.numeric.binary.brat",
          "match": "\\b0[bB][01][01_]*\\b"
        },
        {
          "name": "constant.numeric.octal.brat",
          "match": "\\b0[oO][0-7][0-7_]*\\b"
        },
        {
          "name": "constant.numeric.float.brat",
          "match": "\\b\\d[\\d_]*\\.\\d[\\d_]*(?:[eE][+-]?\\d[\\d_]*)?\\b|\\b\\d[\\d_]*[eE][+-]?\\d[\\d_]*\\b"
        },
        {
          "name": "constant.numeric.integer.brat",
          "match": "\\b\\d[\\d_]*\\b"
        }
      ]
    },
    "calls": {
      "patterns": [
        {
          "name": "support.function.builtin.brat",
          "match": "\\b(len|own|assert|print|str|int|float|typeof|tagof|is_err|is_none|unwrap|chan|time_ms|mono_ns)(?=\\s*\\()"
        },
        {
          "name": "entity.name.function.brat",
          "match": "\\b[a-z_][A-Za-z0-9_]*(?=\\s*\\()"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "constant.other.caps.brat",
          "match": "\\b[A-Z][A-Z0-9_]{2,}\\b"
        },
        {
          "name": "entity.name.type.brat",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.brat",
          "match": "<<=|>>=|<<|>>|=>|->|==|!=|<=|>=|&&|\\|\\||\\.\\.|\\+=|-=|\\*=|/=|%=|&=|\\|=|\\^=|[+\\-*/%=<>!&|^~?]"
        }
      ]
    }
  }
}
