fn add_i64(a: i64, b: i64) -> i64 {
  return a + b
}

fn square(x: i64) -> i64 {
  return x * x
}

fn main() {
  let mut items = []
  let mut i = 1
  while i <= 100 {
    items.push(i)
    i = i + 1
  }
  let sum_sq = par for x in items reduce(add_i64, 0) {
    return square(x)
  }
  assert(sum_sq == 338350)
  print(sum_sq)
}
