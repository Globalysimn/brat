fn open(path: str) -> Result[i64, str]
fn open_memory() -> Result[i64, str]
fn close(db: i64) -> Result[i64, str]
fn exec(db: i64, sql: str) -> Result[i64, str]
fn query(db: i64, sql: str, params) -> Result[vec[map], str]
