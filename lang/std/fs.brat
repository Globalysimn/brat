pub fn exists(path: str) -> bool {
  return fs_exists(path)
}

pub fn is_file(path: str) -> bool {
  return fs_exists(path)
}

pub fn is_dir(path: str) -> bool {
  return fs_is_dir(path)
}

pub fn file_size(path: str) -> Result[i64, str] {
  return fs_file_size(path)
}

pub fn mkdir_all(path: str) -> Result[i64, str] {
  return fs_mkdir_all(path)
}

pub fn list_dir(path: str) -> Result[vec[str], str] {
  return fs_list_dir(path)
}

pub fn rename(src: str, dst: str) -> Result[i64, str] {
  return fs_rename(src, dst)
}

pub fn remove_dir(path: str) -> Result[i64, str] {
  return fs_remove_dir(path)
}

pub fn read_or(path: str, fallback: str) -> str {
  let r = read_file(path)
  if is_err(r) {
    return fallback
  }
  return unwrap(r)
}

pub fn read_lines(path: str) -> Result[vec[str], str] {
  let r = read_file(path)
  if is_err(r) {
    return r
  }
  let text = unwrap(r)
  return Ok(text.lines())
}

pub fn write_lines(path: str, lines: vec[str]) -> Result[i64, str] {
  if len(lines) == 0 {
    return write_file(path, "")
  }
  return write_file(path, lines.join("\n") + "\n")
}

pub fn append_text(path: str, extra: str) -> Result[i64, str] {
  return append_file(path, extra)
}

pub fn write_atomic(path: str, content: str) -> Result[i64, str] {
  let tmp = path + ".brat.tmp"
  let wr = write_file(tmp, content)
  if is_err(wr) {
    return wr
  }
  let rr = fs_rename(tmp, path)
  if is_err(rr) {
    let _rm = fs_remove(tmp)
    return rr
  }
  return wr
}

pub fn remove(path: str) -> Result[i64, str] {
  return fs_remove(path)
}

pub fn open_read(path: str) -> Result[i64, str] {
  return fs_open(path)
}

pub fn read_line(handle: i64) -> Result[Option[str], str] {
  return fs_read_line(handle)
}

pub fn close(handle: i64) -> Result[i64, str] {
  return fs_close(handle)
}

pub fn stdin_line() -> Result[Option[str], str] {
  return stdin_read_line()
}
