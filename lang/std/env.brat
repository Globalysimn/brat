pub fn get(name: str) {
  let v = env_get(name)
  match v {
    Err(e) => return Err(e),
    _ => {
      if is_none(v) {
        return Err("missing env: " + name)
      }
      return Ok(v.slice(0, len(v)))
    }
  }
}

pub fn get_or(name: str, fallback: str) -> str {
  let v = env_get(name)
  if is_err(v) || is_none(v) {
    return fallback.slice(0, len(fallback))
  }
  return v.slice(0, len(v))
}

pub fn has(name: str) -> bool {
  let v = env_get(name)
  if is_err(v) || is_none(v) {
    return false
  }
  return true
}

pub fn flag(name: str) -> bool {
  let v = env_get(name)
  if is_err(v) || is_none(v) {
    return false
  }
  let norm = v.trim().lower()
  return norm == "1" || norm == "true" || norm == "yes" || norm == "on"
}
