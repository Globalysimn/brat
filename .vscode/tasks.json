{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build brat-cxx",
      "type": "shell",
      "command": "make -j4",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$gcc"
    },
    {
      "label": "build brat-cxx (asan)",
      "type": "shell",
      "command": "make -j4 asan",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": "$gcc"
    }
  ]
}
